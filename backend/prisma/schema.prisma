// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum RolUsuario {
  OPERATIVO
  DIRECTOR
  ENLACE
}

enum EstadoSolicitud {
  PENDIENTE
  EN_PROCESO
  RESPONDIDA
  VENCIDA
  PRORROGA_SOLICITADA
}

enum EstadoCargaMensual {
  PENDIENTE
  APROBADA
  PUBLICADA
  RECHAZADA
}

enum TipoAccion {
  CREAR_SOLICITUD
  DERIVAR_SOLICITUD
  RESPONDER_SOLICITUD
  SOLICITAR_PRORROGA
  APROBAR_CARGA
  CREAR_USUARIO
  EDITAR_USUARIO
  PUBLICAR_INFORMACION
  INICIAR_SESION
}

// ============================================
// MODELOS
// ============================================

model Departamento {
  id               Int                @id @default(autoincrement())
  nombre           String
  solicitudes      Solicitud[]
  usuarios         Usuario[]
  itemsResponsable ItemTransparencia[] @relation("departamentoResponsable")

  @@map("departamentos")
}

model Usuario {
  id              Int             @id @default(autoincrement())
  nombre          String
  email           String          @unique
  passwordHash    String          @map("password_hash")
  rol             RolUsuario      @default(OPERATIVO)
  departamento    Departamento    @relation(fields: [departamentoId], references: [id])
  departamentoId  Int             @map("departamento_id")
  solicitudes     Solicitud[]
  logs            Log[]
  notificaciones  Notificacion[]
  cargasMensuales CargaMensual[]

  @@map("usuarios")
}

model ItemTransparencia {
  id                        Int            @id @default(autoincrement())
  nombre                    String
  descripcion               String
  departamentoResponsable   Departamento   @relation("departamentoResponsable", fields: [departamentoResponsableId], references: [id])
  departamentoResponsableId Int            @map("departamento_responsable_id")
  cargasMensuales           CargaMensual[]

  @@map("items_transparencia")
}

model Solicitud {
  id             Int              @id @default(autoincrement())
  folio          String           @unique
  fechaRecepcion DateTime         @map("fecha_recepcion")
  descripcion    String
  estado         EstadoSolicitud  @default(PENDIENTE)
  plazoLimite    DateTime         @map("plazo_limite")
  usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  usuarioId      Int              @map("usuario_id")
  departamento   Departamento     @relation(fields: [departamentoId], references: [id])
  departamentoId Int              @map("departamento_id")
  contenidoRespuesta String?
  fechaRespuesta     DateTime?
  archivos       Archivo[]
  resolucionExenta ResolucionExenta?

  @@map("solicitudes")
}

enum TipoArchivo {
  EVIDENCIA_SOLICITUD
  RESPUESTA
}

model Archivo {
  id          Int       @id @default(autoincrement())
  nombre      String
  ruta        String
  tipo        TipoArchivo
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId Int       @map("solicitud_id")

  @@map("archivos")
}

model Log {
  id        Int        @id @default(autoincrement())
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId Int        @map("usuario_id")
  accion    TipoAccion
  detalle String?
  fechaHora DateTime   @default(now()) @map("fecha_hora")

  @@map("logs")
}

model Notificacion {
  id        Int     @id @default(autoincrement())
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int     @map("usuario_id")
  mensaje   String
  leida     Boolean @default(false)

  @@map("notificaciones")
}

model CargaMensual {
  id         Int                   @id @default(autoincrement())
  item       ItemTransparencia     @relation(fields: [itemId], references: [id])
  itemId     Int                   @map("item_id")
  mes        String
  anio       Int                   @map("anio")
  estado     EstadoCargaMensual    @default(PENDIENTE)
  fechaCarga DateTime              @default(now()) @map("fecha_carga")
  usuario    Usuario               @relation(fields: [usuarioId], references: [id])
  usuarioId  Int                   @map("usuario_id")

  @@map("cargas_mensuales")
}

model ResolucionExenta {
  id            Int       @id @default(autoincrement()) // este ID ES el número correlativo
  fundamentos   String
  fechaEmision  DateTime  @default(now()) @map("fecha_emision")
  solicitud     Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId   Int       @unique @map("solicitud_id") // una solicitud = máximo una resolución de prórroga

  @@map("resoluciones_exentas")
}